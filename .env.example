# ==========================================
# Airi Discord Bot - Environment Configuration
# ==========================================

# Discord Bot Token (จาก https://discord.com/developers/applications)
DISCORD_TOKEN=

# AI Provider - Google Gemini (google-genai)
GOOGLE_API_KEY=
MODEL_NAME=gemini-3.1-flash-lite

# เขตเวลาของไอริ (ค่าเริ่มต้น = เวลาไทย UTC+7)
# ใช้ชื่อ IANA: Asia/Bangkok, Asia/Tokyo, Europe/London, America/New_York ...
# ถ้าไม่ตั้ง → ใช้ Asia/Bangkok กัน server ที่รัน UTC บอกเวลาผิด
TIMEZONE=Asia/Bangkok

# คำนำหน้าคำสั่ง
COMMAND_PREFIX=!

# โหมดการตอบ: mention | active | selective
# mention   = ตอบเมื่อ Mention/Reply ถึง Airi (ค่าเริ่มต้น)
# active    = ตอบทุกข้อความในห้องที่กำหนด
# selective = ตอบเฉพาะห้องที่ได้รับอนุญาต
RESPOND_MODE=mention

# จำนวนข้อความใน Short-term Context สูงสุด
CONTEXT_MESSAGES=20

# อายุ Context (วินาที) - หมดอายุแล้วล้างบริบทอัตโนมัติ
CONTEXT_TTL_SECONDS=7200

# ห้องที่อนุญาตให้ตอบในโหมด active/selective (คั่นด้วย , ใส่ 0 = ยังไม่กำหนด)
ALLOWED_CHANNELS=0

# ห้องที่ล็อกให้ไอริตอบ (0 = ยังไม่ล็อก → Mention ยังตอบได้ทุกห้อง)
# ตั้งง่ายๆ ด้วยคำสั่ง /jump #ห้อง ใน Discord
CHANNEL_ID=0

# ห้องต้อนรับสมาชิกใหม่ (0 = ปิด)
WELCOME_CHANNEL_ID=0

# ห้องแจ้งเตือนเวลา อรุณสวัสดิ์/ฝันดี (0 = ปิด)
ANNOUNCEMENT_CHANNEL_ID=0

# ยศที่ใช้สำหรับระบบไล่นอน (คั่นด้วย , เว้นว่าง = ทุกคน)
SLEEP_ROLE_NAMES=member
